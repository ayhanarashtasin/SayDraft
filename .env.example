# Project URL, server-only secret key and publishable key from the Supabase dashboard
# (Project Settings > API Keys). The publishable key is used on the server only, for sign-in.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Invite code for creating accounts: share it only with the people who may sign up.
# Use at least 16 random characters. Every account spends your OpenAI key, so on a public
# domain sign-up stays closed until this is set. It can be left blank on your own computer.
# Generate one with: node -p "require('node:crypto').randomBytes(24).toString('base64url')"
SIGNUP_CODE=

# Enables transcription, titles, rewrites and translation.
OPENAI_API_KEY=

# Optional OpenAI-compatible endpoint and default models.
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# OPENAI_REWRITE_MODEL=gpt-4.1-mini
# OPENAI_DIARIZE_MODEL=gpt-4o-transcribe-diarize

# Optional per-file upload limit in MiB. Match your Supabase Storage limits.
# MAX_UPLOAD_MB=50

# Comma-separated custom domains, without https://. Vercel's system domains are detected automatically.
# ALLOWED_HOSTS=notes.example.com

# Optional ffmpeg override for self-hosting. The app bundles ffmpeg by default.
# FFMPEG_PATH=
